[Desktop Entry]
Type=Application
Name=Peek2
GenericName=Screen Recorder
Comment=Record a screen region to WebM, MP4 or GIF, with audio
Exec=peek2
Icon=media-record
Terminal=false
Categories=AudioVideo;Video;Recorder;
Keywords=screencast;recorder;gif;webm;mp4;clip;screenshot;
StartupNotify=false
Actions=Screenshot;Replay;Stop;

[Desktop Action Screenshot]
Name=Screenshot
Exec=peek2 --screenshot

[Desktop Action Replay]
Name=Replay buffer on/off
Exec=peek2 --replay

[Desktop Action Stop]
Name=Stop recording
Exec=peek2 --stop
